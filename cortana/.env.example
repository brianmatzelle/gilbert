# ===========================================
# Cortana Discord Bot - Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ========== Discord ==========
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ========== Ollama LLM ==========
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=huihui_ai/qwen3-abliterated:8b

# ========== Whisper STT ==========
# Model sizes: tiny, base, small, medium, large-v3
# "small" recommended for best speed/accuracy balance
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ========== Kokoro TTS ==========
# Download models from: https://huggingface.co/hexgrad/Kokoro-82M
# Place in models/kokoro/ directory
KOKORO_MODEL_PATH=../garvis/models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=../garvis/models/kokoro/voices-v1.0.bin

# Voices: af_heart (best), af_bella, af_nicole, am_michael, am_fenrir
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG=en-us

# ========== VAD (Voice Activity Detection) ==========
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=500

# ========== Hardware ==========
USE_CUDA=true
AUDIO_THREAD_POOL_SIZE=4

# ========== Features ==========
# Barge-in allows users to interrupt Cortana mid-response
ENABLE_BARGE_IN=false
BARGE_IN_MIN_SPEAK_MS=500
