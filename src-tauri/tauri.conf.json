{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guitar2Discord",
  "version": "0.1.0",
  "identifier": "com.guitar2discord.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Guitar2Discord",
        "width": 380,
        "height": 550,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
