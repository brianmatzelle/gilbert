# Garvis Discord Voice Assistant - Dockerfile (Local/GPU Mode)
# This image includes CUDA support for local STT (Whisper) and VAD (Silero)
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d

# =============================================================================
# Stage 1: Builder - Install dependencies with CUDA support
# =============================================================================
FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS builder

# Install Python and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    python3.12-dev \
    python3-pip \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set up working directory
WORKDIR /app

# Copy dependency files first for better caching
COPY server/pyproject.toml server/uv.lock ./server/

# Install Python dependencies with CUDA-enabled PyTorch
ENV UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/cu121
WORKDIR /app/server
RUN uv sync --frozen --no-dev

# =============================================================================
# Stage 2: Runtime - Final image with CUDA
# =============================================================================
FROM nvidia/cuda:12.1-runtime-ubuntu22.04 AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    ffmpeg \
    libopus0 \
    libsodium23 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && ln -s /usr/bin/python3.12 /usr/bin/python

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash garvis
USER garvis

# Set up working directory
WORKDIR /app

# Copy virtual environment from builder
COPY --from=builder --chown=garvis:garvis /app/server/.venv /app/server/.venv

# Copy application code
COPY --chown=garvis:garvis server/ /app/server/
COPY --chown=garvis:garvis openclaw/ /app/openclaw/

# Set environment variables
ENV PATH="/app/server/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# CUDA environment
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Bot API port (for OpenClaw integration)
EXPOSE 8765

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:8765/api/status || exit 1

# Working directory for running the bot
WORKDIR /app/server

# Default command
CMD ["python", "-m", "discord_bot.bot"]
