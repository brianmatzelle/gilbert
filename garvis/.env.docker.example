# =============================================================================
# Garvis Docker Configuration
# =============================================================================
# Copy this file to .env and fill in your API keys.
# Run: ./setup.sh for interactive configuration
#
# Quick start:
#   1. cp .env.docker.example .env
#   2. Fill in REQUIRED section below
#   3. docker compose up -d
# =============================================================================

# =============================================================================
# REQUIRED - You must fill these in
# =============================================================================

# Discord Bot Token (REQUIRED)
# Create a bot at: https://discord.com/developers/applications
# Enable: Message Content Intent, Server Members Intent, Presence Intent
# Invite URL permissions: Connect, Speak, Use Voice Activity
DISCORD_BOT_TOKEN=

# OpenClaw Gateway (REQUIRED for memory/proactive features)
# Self-host or get a gateway at: https://docs.molt.bot/
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSION_KEY=discord-voice-main
USE_OPENCLAW=true

# =============================================================================
# CLOUD API KEYS - Required for cloud mode (default)
# =============================================================================

# Anthropic Claude - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Deepgram STT - https://console.deepgram.com/
DEEPGRAM_API_KEY=

# ElevenLabs TTS - https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# =============================================================================
# LLM Configuration
# =============================================================================

# Claude model for responses
# Fast: claude-3-5-haiku-20241022 (~500ms, recommended for voice)
# Smart: claude-sonnet-4-20250514 (~2000ms, better quality)
CLAUDE_MODEL=claude-3-5-haiku-20241022

# =============================================================================
# Discord Features
# =============================================================================

# Send text responses in addition to voice
DISCORD_SEND_TEXT_MESSAGES=true

# Speaker attribution (who said what)
DISCORD_SPEAKER_ATTRIBUTION=true

# Mute specific users (comma-separated usernames or IDs)
DISCORD_MUTED_USERS=

# =============================================================================
# Voice Pipeline Settings (sensible defaults, adjust if needed)
# =============================================================================

# Deepgram STT
DEEPGRAM_MODEL=nova-2
DEEPGRAM_ENDPOINTING=500
DEEPGRAM_UTTERANCE_END_MS=1200
DEEPGRAM_USE_SPEECH_FINAL=true
DEEPGRAM_DEBUG=false

# Silero VAD (voice activity detection)
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=500

# Turn detection
INCOMPLETE_UTTERANCE_EXTENDED_SILENCE_MS=1200

# TTS streaming
TTS_PREBUFFER_MS=250

# Barge-in (interruption)
ENABLE_BARGE_IN=true
BARGE_IN_MIN_SPEAK_MS=500

# Audio processing
AUDIO_PROCESS_INTERVAL=0.05
AUDIO_THREAD_POOL_SIZE=4

# =============================================================================
# Proactive Features
# =============================================================================

# Assistant mode (wake word required)
ASSISTANT_MODE=false
WAKE_WORD=garvis

# Auto-join voice channels
AUTO_JOIN_ENABLED=false
AUTO_JOIN_DELAY_MS=2000
AUTO_JOIN_MIN_USERS=1
AUTO_JOIN_CHANNELS=
AUTO_JOIN_USERS=
AUTO_JOIN_USE_OPENCLAW=true
AUTO_JOIN_OPENCLAW_TIMEOUT=5.0
AUTO_JOIN_SPEAK_FIRST=true

# =============================================================================
# Bot API (for OpenClaw cron jobs)
# Configured automatically by docker-compose.yml
# =============================================================================
BOT_API_ENABLED=true
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8765

# =============================================================================
# LOCAL MODELS (optional - use docker-compose.local.yml)
# =============================================================================
# These are automatically set by docker-compose.local.yml
# Only uncomment if you want to override the defaults

# USE_LOCAL_LLM=false
# USE_LOCAL_STT=false
# USE_LOCAL_TTS=false
# USE_KOKORO_TTS=false
# USE_CUDA=false

# Local LLM (llama.cpp server)
# LOCAL_LLM_URL=http://llama-server:8080/v1
# LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# Local STT (faster-whisper)
# WHISPER_MODEL=small
# WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE=float16

# Local TTS (Piper)
# PIPER_MODEL_PATH=/app/models/piper/en_US-lessac-medium.onnx
# PIPER_SPEAKER=0
# PIPER_LENGTH_SCALE=1.0

# Local TTS (Kokoro - recommended)
# KOKORO_MODEL_PATH=/app/models/kokoro/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=/app/models/kokoro/voices-v1.0.bin
# KOKORO_VOICE=af_heart
# KOKORO_SPEED=1.0
