# Garvis Server Environment Variables
# Copy this to .env and fill in your API keys

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram - https://console.deepgram.com/
DEEPGRAM_API_KEY=...

# Eleven Labs - https://elevenlabs.io/
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # George voice (default)
# Flash model is fastest (~75ms), turbo is higher quality but slower (~150ms)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Output format: mp3_44100_128 (WebSocket only supports MP3, converted to PCM for Discord)
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Claude model to use
# For voice: claude-3-5-haiku-20241022 is MUCH faster (~500ms vs ~2000ms)
# For quality: claude-sonnet-4-20250514 is smarter but slower
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Discord Bot (for voice assistant feature)
# Create a bot at https://discord.com/developers/applications
# Required permissions: Connect, Speak, Use Voice Activity
DISCORD_BOT_TOKEN=...
DISCORD_SEND_TEXT_MESSAGES=true

# ========== Discord Audio Filtering ==========
# Mute specific users/bots so Garvis doesn't listen to them (e.g., music bots)
# Comma-separated list of Discord usernames or user IDs
# Example: "Jockie Music,Rythm,123456789012345678"
# You can also use !mute @user in Discord to mute at runtime
DISCORD_MUTED_USERS=

# Enable speaker attribution in transcripts
# When enabled, Garvis knows who said what ("Brian: Hello" vs just "Hello")
# This enables personalized responses and per-user memory with OpenClaw
DISCORD_SPEAKER_ATTRIBUTION=true

# ========== Voice Pipeline Performance Tuning ==========

# Deepgram STT Configuration
# Model: nova-2 is fast and accurate
DEEPGRAM_MODEL=nova-2
# Endpointing: ms of silence before speech_final triggers
# 500ms is the developer consensus "sweet spot" - balances responsiveness with natural pauses
# Lower (300ms) = faster but may cut off, Higher (700ms) = feels sluggish
DEEPGRAM_ENDPOINTING=500
# UtteranceEnd fallback (only used if speech_final doesn't fire)
DEEPGRAM_UTTERANCE_END_MS=1200
# Use speech_final for faster response (vs waiting for UtteranceEnd)
DEEPGRAM_USE_SPEECH_FINAL=true
# Debug logging for Deepgram events (shows all transcript events)
DEEPGRAM_DEBUG=false

# Audio processing interval (how often to process accumulated audio)
AUDIO_PROCESS_INTERVAL=0.05

# ========== Silero VAD Configuration ==========
# Local voice activity detection for accurate speaking state
# Silero VAD is downloaded automatically on first use

# VAD probability threshold (0.0-1.0) - higher = more strict, fewer false positives
VAD_THRESHOLD=0.5
# Minimum speech duration (ms) before triggering speech start
# Prevents brief noises from triggering speaking state
VAD_MIN_SPEECH_MS=250
# Minimum silence duration (ms) before triggering speech end
# 500ms is the developer consensus sweet spot
VAD_MIN_SILENCE_MS=500

# ========== Semantic Turn Detection ==========
# When an utterance appears incomplete (ends with "but", "um", "and"...),
# we wait for this extended silence before responding.
# This prevents cutting off users mid-thought while maintaining responsiveness.
INCOMPLETE_UTTERANCE_EXTENDED_SILENCE_MS=1200

# TTS streaming configuration
# Prebuffer: ms of audio to accumulate before starting playback (smooths network jitter)
TTS_PREBUFFER_MS=250

# ========== Hardware Acceleration ==========
# Enable CUDA for GPU-accelerated VAD inference (RTX GPUs)
# Set to false to force CPU even if CUDA is available
USE_CUDA=true

# Thread pool size for CPU-bound audio processing
# This prevents blocking the asyncio event loop during:
# - Audio format conversion (pydub/ffmpeg: 48kHz→16kHz, MP3→PCM)
# - VAD inference (when not using CUDA)
# Set to 0 for auto (usually number of CPU cores)
AUDIO_THREAD_POOL_SIZE=4

# ========== Barge-in / Interruption ==========
# Allow users to interrupt Garvis mid-response by speaking
# When enabled: current LLM/TTS response is cancelled, new input is processed immediately
# When disabled: user speech is queued until bot finishes speaking (can cause lag buildup)
ENABLE_BARGE_IN=true

# Minimum time (ms) the bot must be speaking before barge-in is allowed
# This prevents false barge-ins from echo/feedback when the response just starts
# Set to 0 to allow immediate interruption (may cause issues with echo)
BARGE_IN_MIN_SPEAK_MS=500

# ========== Local Model Configuration ==========
# Enable local models instead of cloud APIs for faster inference
# Requires running setup-local-models.sh first to download models
#
# Benefits of local inference:
# - No network latency (3-4x faster total response time)
# - No API costs
# - Full privacy (no data sent to cloud)
# - Works offline
#
# Hardware requirements (RTX 4070 12GB VRAM is ideal):
# - LLM (Qwen2.5-7B Q4): ~4.5GB VRAM
# - STT (Whisper small): ~1GB VRAM  
# - TTS (Piper): CPU only

# Master switches - set to "true" to use local models
USE_LOCAL_LLM=false
USE_LOCAL_STT=false
USE_LOCAL_TTS=false

# ========== Local LLM (llama.cpp + Qwen2.5-7B) ==========
# Start the server with: ./run-llama-server.sh (or .ps1 on Windows)
LOCAL_LLM_URL=http://localhost:8080/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# ========== Local STT (faster-whisper) ==========
# Model sizes: tiny, base, small, medium, large-v3
# Recommended: "small" for best speed/accuracy on RTX 4070 (~1GB VRAM)
WHISPER_MODEL=small
# Device: "cuda" for GPU (faster), "cpu" for CPU
WHISPER_DEVICE=cuda
# Compute type: "float16" for GPU, "int8" for CPU/faster, "float32" for accuracy
WHISPER_COMPUTE_TYPE=float16

# ========== Local TTS (Piper) ==========
# Piper is a fast but robotic-sounding TTS option
# Path to Piper model (downloaded by setup-local-models.sh)
# PIPER_MODEL_PATH=../models/piper/en_US-lessac-medium.onnx
# Speaker settings
PIPER_SPEAKER=0
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8

# ========== Local TTS (Kokoro) - RECOMMENDED ==========
# Kokoro is a highly realistic neural TTS model
# Ranked #1 on HuggingFace TTS Arena, often indistinguishable from ElevenLabs
# Set USE_KOKORO_TTS=true to use Kokoro instead of Piper for local TTS
USE_KOKORO_TTS=false
# Path to Kokoro model files (downloaded by setup-local-models.sh)
# KOKORO_MODEL_PATH=../models/kokoro/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=../models/kokoro/voices-v1.0.bin
# Voice selection - see https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
# Best female: af_heart (A), af_bella (A-)
# Best male: am_michael (C+), am_fenrir (C+)
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG=en-us

# ========== OpenClaw Integration (Future) ==========
# Enable OpenClaw as the agent engine for persistent memory, tools, and sessions
# See: https://docs.molt.bot/
USE_OPENCLAW=false
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main
OPENCLAW_SESSION_KEY=discord-voice-main

# ========== Assistant Mode (Wake Word) ==========
# When enabled, Garvis only responds when the user starts with "Garvis..."
# Similar to Alexa's wake word - reduces unwanted responses and saves LLM compute
# Toggle at runtime with !assistant command in Discord
ASSISTANT_MODE=false

# Wake word to listen for (case-insensitive)
# Supports variations like "Garvis", "Hey Garvis", "Ok Garvis", etc.
# Note: STT often transcribes "Jarvis" as "Garvis" due to built-in normalization
WAKE_WORD=garvis
