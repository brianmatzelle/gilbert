# Garvis Server Environment Variables
# Copy this to .env and fill in your API keys

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram - https://console.deepgram.com/
DEEPGRAM_API_KEY=...

# Eleven Labs - https://elevenlabs.io/
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # George voice (default)
# Flash model is fastest (~75ms), turbo is higher quality but slower (~150ms)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Output format: mp3_44100_128 (WebSocket only supports MP3, converted to PCM for Discord)
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Claude model to use
CLAUDE_MODEL=claude-sonnet-4-20250514

# Discord Bot (for voice assistant feature)
# Create a bot at https://discord.com/developers/applications
# Required permissions: Connect, Speak, Use Voice Activity
DISCORD_BOT_TOKEN=...
DISCORD_SEND_TEXT_MESSAGES=false