# Garvis Server Environment Variables
# Copy this to .env and fill in your API keys

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram - https://console.deepgram.com/
DEEPGRAM_API_KEY=...

# Eleven Labs - https://elevenlabs.io/
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb  # George voice (default)
# Flash model is fastest (~75ms), turbo is higher quality but slower (~150ms)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Output format: mp3_44100_128 (WebSocket only supports MP3, converted to PCM for Discord)
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Claude model to use
# For voice: claude-3-5-haiku-20241022 is MUCH faster (~500ms vs ~2000ms)
# For quality: claude-sonnet-4-20250514 is smarter but slower
CLAUDE_MODEL=claude-3-5-haiku-20241022

# Discord Bot (for voice assistant feature)
# Create a bot at https://discord.com/developers/applications
# Required permissions: Connect, Speak, Use Voice Activity
DISCORD_BOT_TOKEN=...
DISCORD_SEND_TEXT_MESSAGES=true

# ========== Voice Pipeline Performance Tuning ==========

# Deepgram STT Configuration
# Model: nova-2 is fast and accurate
DEEPGRAM_MODEL=nova-2
# Endpointing: ms of silence before speech_final triggers
# 500ms is the developer consensus "sweet spot" - balances responsiveness with natural pauses
# Lower (300ms) = faster but may cut off, Higher (700ms) = feels sluggish
DEEPGRAM_ENDPOINTING=500
# UtteranceEnd fallback (only used if speech_final doesn't fire)
DEEPGRAM_UTTERANCE_END_MS=1200
# Use speech_final for faster response (vs waiting for UtteranceEnd)
DEEPGRAM_USE_SPEECH_FINAL=true
# Debug logging for Deepgram events (shows all transcript events)
DEEPGRAM_DEBUG=false

# Audio processing interval (how often to process accumulated audio)
AUDIO_PROCESS_INTERVAL=0.05

# ========== Silero VAD Configuration ==========
# Local voice activity detection for accurate speaking state
# Silero VAD is downloaded automatically on first use

# VAD probability threshold (0.0-1.0) - higher = more strict, fewer false positives
VAD_THRESHOLD=0.5
# Minimum speech duration (ms) before triggering speech start
# Prevents brief noises from triggering speaking state
VAD_MIN_SPEECH_MS=250
# Minimum silence duration (ms) before triggering speech end
# 500ms is the developer consensus sweet spot
VAD_MIN_SILENCE_MS=500

# ========== Semantic Turn Detection ==========
# When an utterance appears incomplete (ends with "but", "um", "and"...),
# we wait for this extended silence before responding.
# This prevents cutting off users mid-thought while maintaining responsiveness.
INCOMPLETE_UTTERANCE_EXTENDED_SILENCE_MS=1200

# TTS streaming configuration
# Prebuffer: ms of audio to accumulate before starting playback (smooths network jitter)
TTS_PREBUFFER_MS=250

# ========== Hardware Acceleration ==========
# Enable CUDA for GPU-accelerated VAD inference (RTX GPUs)
# Set to false to force CPU even if CUDA is available
USE_CUDA=true

# Thread pool size for CPU-bound audio processing
# This prevents blocking the asyncio event loop during:
# - Audio format conversion (pydub/ffmpeg: 48kHz→16kHz, MP3→PCM)
# - VAD inference (when not using CUDA)
# Set to 0 for auto (usually number of CPU cores)
AUDIO_THREAD_POOL_SIZE=4

# ========== Barge-in / Interruption ==========
# Allow users to interrupt Garvis mid-response by speaking
# When enabled: current LLM/TTS response is cancelled, new input is processed immediately
# When disabled: user speech is queued until bot finishes speaking (can cause lag buildup)
ENABLE_BARGE_IN=true

# Minimum time (ms) the bot must be speaking before barge-in is allowed
# This prevents false barge-ins from echo/feedback when the response just starts
# Set to 0 to allow immediate interruption (may cause issues with echo)
BARGE_IN_MIN_SPEAK_MS=500
